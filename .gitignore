__pycache__/
*.pyc
ig/media/latest_*.txt
# Salida de correr make-ig-cambios.py a mano, para mirar el carrusel: lo que se
# publica lo genera ig_daily.py en ig/media/cambios-<fecha>/.
ig/cambios/
# Punteros de la placa del dia: se reescriben en cada corrida. La rotacion en
# si (last_placa.txt) SI se commitea, es lo unico que tiene que sobrevivir.
ig/media/placa_*.txt

# Generados por make-ig-reel.py
ig/reel/data.js
ig/reel/track.wav
ig/reel/frames/
ig/reel/verdict.json
node_modules/

ig/media/reel_asset.txt
ig/media/reel_video.txt

# Worktrees de Claude: repos git anidados, no van al repo.
.claude/
# Voz en off del reel: los wav intermedios y los modelos de piper (63 MB cada
# uno) se regeneran y se bajan, no van al repo.
ig/reel/voz_tmp/
ig/reel/voces/
# Los MP4 de los reels ya no se commitean: van como adjuntos del release
# "media". Cada uno pesa ~3 MB y un commit no se deshace sin reescribir el
# historial; un adjunto se borra de verdad. Los .txt de caption si quedan, que
# pesan nada y sirven de registro de que se dijo cada dia.
ig/reels/*.mp4
